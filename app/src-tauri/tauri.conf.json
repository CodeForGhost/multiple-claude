{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bridge",
  "version": "0.1.0",
  "identifier": "dev.bridge.app",
  "build": {
    "frontendDist": "../ui",
    "beforeBuildCommand": "npm --prefix ../packages/bridge run build",
    "beforeDevCommand": "npm --prefix ../packages/bridge run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Bridge",
        "width": 980,
        "height": 760,
        "minWidth": 420,
        "minHeight": 480,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:* ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../packages/bridge/dist/bridge.cjs": "bridge/bridge.cjs"
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
